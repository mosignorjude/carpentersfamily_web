# Public configuration required by the Supabase SSR clients. The publishable key
# is intended for browser use; RLS, not key secrecy, enforces row access.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Set true only after Google OAuth credentials are configured in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Keep private credential placeholders blank here. Put real secrets only in an
# ignored local environment file or the hosting/provider secret manager.
# Receipt uploads/downloads use a server-only Supabase secret key. Never prefix
# this with NEXT_PUBLIC_. The legacy service-role key name remains supported.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Resend Email Configuration (Server-only). Never prefix API/webhook keys with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL="Carpenters Family <info@mail.carpentersfamily.com.ng>"
RESEND_REPLY_TO_EMAIL="contact@mail.carpentersfamily.com.ng"
RESEND_FORWARD_TO_EMAIL="carpentersfamily001@gmail.com"

# Server-only Cloudflare R2 receipt storage. Never expose these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional origin override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
